{
  "name": "faultlab",
  "version": "1.0.0",
  "description": "FaultLab - Scalable API Simulation and Failure-Testing Platform",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "start": "npm --prefix server start",
    "start:server": "npm --prefix server start",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:migrate:deploy": "npm --prefix server run prisma:migrate:deploy",
    "agent": "npx --prefix server tsx packages/faultlab-agent/src/cli.ts",
    "build:agent": "npx --prefix server tsc -p packages/faultlab-agent/tsconfig.json",
    "test:auth": "npm --prefix server run test:auth",
    "test:workspace": "npm --prefix server run test:workspace",
    "test:project": "npm --prefix server run test:project",
    "test:endpoint": "npm --prefix server run test:endpoint",
    "test:fault": "npm --prefix server run test:fault",
    "test:request": "npm --prefix server run test:request",
    "test:api-testing": "npm --prefix server run test:api-testing",
    "test:diagnostic": "npm --prefix server run test:diagnostic",
    "test:agent": "npm --prefix server run test:agent",
    "test:encryption": "npm --prefix server run test:encryption",
    "test:proxy": "npm --prefix server run test:proxy",
    "test:reliability": "npm --prefix server run test:reliability",
    "test:all": "npm --prefix server run test:auth && npm --prefix server run test:workspace && npm --prefix server run test:project && npm --prefix server run test:endpoint && npm --prefix server run test:fault && npm --prefix server run test:request && npm --prefix server run test:api-testing && npm --prefix server run test:diagnostic && npm --prefix server run test:agent && npm --prefix server run test:encryption"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "faultlab",
    "api-simulation",
    "chaos-engineering",
    "failure-testing"
  ],
  "author": "FaultLab Team",
  "license": "ISC"
}
