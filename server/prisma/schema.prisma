// FaultLab - Prisma Schema
// Phase 1: Foundational Models (User, Workspace)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspaces   Workspace[]

  @@map("users")
}

model Workspace {
  id        String    @id @default(uuid())
  name      String
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ownerId])
  @@map("workspaces")
}

model Project {
  id          String         @id @default(uuid())
  name        String
  description String?
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoints         MockEndpoint[]
  requestLogs       RequestLog[]
  apiTests          ApiTest[]
  apiTestRuns       ApiTestRun[]
  diagnosticReports ApiDiagnosticReport[]
  localAgents           LocalAgent[]
  agentPairingSessions  AgentPairingSession[]
  agentTasks            AgentTask[]
  createdAt         DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([workspaceId])
  @@map("projects")
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum FailureMode {
  NONE
  ALWAYS
  RANDOM
}

model MockEndpoint {
  id                  String      @id @default(uuid())
  projectId           String
  project             Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  method              HttpMethod
  path                String
  statusCode          Int         @default(200)
  responseBody        Json?       @default("{}")
  responseHeaders     Json?
  responseDelay       Int         @default(0)
  faultEnabled        Boolean     @default(false)
  failureMode         FailureMode @default(NONE)
  failureRate         Int         @default(0)
  failureStatusCode   Int         @default(500)
  failureResponseBody Json?       @default("{\"error\": \"Internal Server Error\", \"message\": \"Simulated fault injection\"}")
  additionalDelay     Int         @default(0)
  requestLogs         RequestLog[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([projectId, method, path])
  @@index([projectId])
  @@map("mock_endpoints")
}

model RequestLog {
  id              String        @id @default(uuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  endpointId      String?
  endpoint        MockEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  method          String
  path            String
  statusCode      Int
  responseTime    Int
  requestSize     Int?
  responseSize    Int?
  isFaultInjected Boolean       @default(false)
  wasMatched      Boolean       @default(true)
  createdAt       DateTime      @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, statusCode])
  @@index([projectId, method])
  @@index([endpointId])
  @@map("request_logs")
}

enum AuthType {
  NONE
  BEARER
  BASIC
  API_KEY
}

enum TestRunStatus {
  PASSED
  FAILED
  ERROR
}

model ApiTest {
  id                   String        @id @default(uuid())
  projectId            String
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String
  method               HttpMethod
  url                  String
  queryParams          Json?         @default("[]")
  headers              Json?         @default("[]")
  requestBody          String?
  authenticationType   AuthType      @default(NONE)
  authenticationConfig String?       // AES-256-GCM encrypted JSON string containing secrets
  timeoutMs            Int           @default(5000)
  expectedStatusCode   Int?
  expectedResponse     Json?         @default("[]") // List of JSON path assertions: [{ field, operator, value }]
  maxResponseTime      Int?          // Latency threshold in ms
  testRuns             ApiTestRun[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([projectId])
  @@map("api_tests")
}

model ApiTestRun {
  id                    String        @id @default(uuid())
  projectId             String
  project               Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiTestId             String?
  apiTest               ApiTest?      @relation(fields: [apiTestId], references: [id], onDelete: Cascade)
  status                TestRunStatus
  actualStatusCode      Int?
  responseTime          Int           // Milliseconds elapsed
  responseSize          Int?          // In bytes
  responseHeaders       Json?         // Sanitized response headers
  assertionResults      Json          @default("[]") // Detailed outcomes: [{ name, expected, actual, passed, message }]
  sanitizedResponseBody String?       // Truncated / sanitized response body (e.g. max 64KB)
  errorMessage          String?       // Detailed error if status is ERROR
  diagnosticReport      ApiDiagnosticReport?
  executedAt            DateTime      @default(now())

  @@index([projectId, executedAt(sort: Desc)])
  @@index([apiTestId, executedAt(sort: Desc)])
  @@map("api_test_runs")
}

enum DiagnosticStatus {
  HEALTHY
  WARNING
  CRITICAL_ISSUES
}

model ApiDiagnosticReport {
  id            String            @id @default(uuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiTestRunId  String?           @unique
  apiTestRun    ApiTestRun?       @relation(fields: [apiTestRunId], references: [id], onDelete: Cascade)
  overallStatus DiagnosticStatus  @default(HEALTHY)
  summary       String
  totalFindings Int               @default(0)
  findings      Json              @default("[]")
  createdAt     DateTime          @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([overallStatus])
  @@map("api_diagnostic_reports")
}

enum AgentStatus {
  ONLINE
  OFFLINE
  REVOKED
}

enum AgentTaskStatus {
  PENDING
  PICKED_UP
  COMPLETED
  FAILED
  EXPIRED
}

model LocalAgent {
  id             String       @id @default(uuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  tokenHash      String       @unique
  approvedOrigin String
  status         AgentStatus  @default(ONLINE)
  lastSeenAt     DateTime?
  systemInfo     Json?        @default("{}")
  tasks          AgentTask[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projectId])
  @@index([tokenHash])
  @@map("local_agents")
}

model AgentPairingSession {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeHash       String    @unique
  approvedOrigin String
  agentName      String?
  expiresAt      DateTime
  isUsed         Boolean   @default(false)
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([projectId])
  @@index([codeHash])
  @@map("agent_pairing_sessions")
}

model AgentTask {
  id            String          @id @default(uuid())
  agentId       String
  agent         LocalAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String          @default("EXECUTE_API_TEST")
  status        AgentTaskStatus @default(PENDING)
  payload       Json
  result        Json?
  apiTestRunId  String?
  expiresAt     DateTime
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([agentId, status])
  @@index([projectId])
  @@map("agent_tasks")
}




