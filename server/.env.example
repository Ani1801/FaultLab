# Server Port
PORT=5000

# Node Environment (development, production, test)
NODE_ENV=development

# Allowed CORS Origin for Client
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URLs (Neon / Supabase / Local)
# DATABASE_URL: Pooled connection string used by Prisma Client queries
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/faultlab?sslmode=require
# DIRECT_URL: Direct non-pooled connection string used by Prisma CLI migrations
DIRECT_URL=postgresql://user:password@ep-sample.region.neon.tech/faultlab?sslmode=require

# Authentication & JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h
COOKIE_NAME=faultlab_auth

# Real API Testing Engine Encryption & SSRF Configuration
API_TEST_ENCRYPTION_KEY=your_64_hex_character_encryption_key_at_least_32_bytes_long
ALLOW_LOCAL_NETWORK_API_TESTING=false


